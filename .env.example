# 이 파일을 복사해서 .env 로 만들고 실제 값을 채우세요.
# cp .env.example .env

# PostgreSQL 연결 문자열 (Railway 등에서 발급)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kin?schema=public"

# OpenRouter API 키 (https://openrouter.ai/keys)
OPENROUTER_API_KEY="sk-or-..."

# JWT 서명 시크릿 (랜덤 문자열 32자 이상)
JWT_SECRET="change-this-to-a-random-secret-at-least-32-chars"

# Toss Payments 시크릿 키 (서버용)
TOSS_SECRET_KEY="test_sk_..."

# Toss Payments 클라이언트 키 (브라우저용)
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_..."

# 앱 URL (배포 시 실제 도메인으로 교체)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
